{
  "expo": {
    "name": "Barnabas Journal",
    "slug": "barnabas-journal",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "barnabas-journal",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f8d6e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fbf1e0"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayVerse",
              "label": "Today's Verse",
              "description": "Shows today's Barnabas Journal verse on your home screen.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayFact",
              "label": "Fact of the Day",
              "description": "Shows today's Barnabas Journal fact on your home screen.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withShareShortcut"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barnabasjournal.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.barnabasjournal.app",
      "versionCode": 5,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#E69138",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fe93cf8f-fb13-4188-89d1-d1a615a3a246"
      },
      "sentryDsn": ""
    },
    "owner": "arthurdongz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe93cf8f-fb13-4188-89d1-d1a615a3a246"
    }
  }
}
