{
  "expo": {
    "name": "Barnabas Journal",
    "slug": "barnabas-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "barnabas-journal",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7c9885"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f4f0e6"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barnabasjournal.app"
    },
    "android": {
      "package": "com.barnabasjournal.app",
      "versionCode": 2,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#E3B05A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fe93cf8f-fb13-4188-89d1-d1a615a3a246"
      }
    },
    "owner": "arthurdongz"
  }
}
